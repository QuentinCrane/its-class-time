<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClassTime.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClassTime"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="“上课”时间到！">

    <Grid>
        <Grid.Resources>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>
        </Grid.Resources>

        <NavigationView
            x:Name="Nav"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left"
            SelectionChanged="Nav_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="作息计划" Tag="schedule">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Calendar" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="显示与位置" Tag="display">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="View" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="通知" Tag="notifications">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Ringer" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="常规" Tag="general">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Margin="24,16,24,24">
                <!-- 作息计划 -->
                <ScrollViewer x:Name="ScheduleScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" Spacing="16" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock Text="作息计划" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="以高中/大学示例为基础，按你的实际课表调整。修改只会写入本地配置，不会改动随包示例。"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="模板" VerticalAlignment="Center" />
                                    <ComboBox x:Name="TemplateCombo" Grid.Column="1" MinWidth="220"
                                              SelectionChanged="TemplateCombo_SelectionChanged" />
                                </Grid>
                                <TextBlock x:Name="TemplateStatusText" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <StackPanel Spacing="6">
                                    <TextBlock Text="生效星期" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel x:Name="WeekdayPanel" Orientation="Horizontal" Spacing="4" />
                                </StackPanel>
                                <StackPanel x:Name="SegmentList" Spacing="4" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="AddSegmentButton" Content="新增时段" Click="AddSegment_Click" />
                                    <Button x:Name="RestorePresetButton" Content="恢复随包预设" Click="RestorePreset_Click" />
                                    <Button x:Name="ClearOverrideButton" Content="撤销今日临时调整" Click="ClearOverride_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 显示与位置 -->
                <ScrollViewer x:Name="DisplayScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" Spacing="16" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock Text="显示与位置" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="悬浮层始终按真实时钟推进；切换显示形式不会改变提醒状态。"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="显示形式" FontWeight="SemiBold" />
                                <RadioButtons x:Name="ViewRadio" SelectionChanged="ViewRadio_SelectionChanged">
                                    <x:String>分节长条</x:String>
                                    <x:String>圆环</x:String>
                                </RadioButtons>
                                <TextBlock Text="显示范围" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <RadioButtons x:Name="ScopeRadio" SelectionChanged="ScopeRadio_SelectionChanged">
                                    <x:String>全天</x:String>
                                    <x:String>当前时段</x:String>
                                </RadioButtons>
                                <TextBlock Text="贴边位置" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <RadioButtons x:Name="EdgeRadio" SelectionChanged="EdgeRadio_SelectionChanged">
                                    <x:String>贴在屏幕顶部</x:String>
                                    <x:String>贴在屏幕底部</x:String>
                                </RadioButtons>
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                    <ToggleSwitch x:Name="VisibleToggle" Header="显示悬浮窗"
                                                  Toggled="VisibleToggle_Toggled" />
                                    <Button Content="重新贴边" VerticalAlignment="Bottom" Click="Reanchor_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 通知 -->
                <ScrollViewer x:Name="NotificationsScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" Spacing="16" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock Text="通知" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="到边界时由正在运行的时钟判断并调用系统通知；不会提前向系统排一天的通知。"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="12">
                                <ToggleSwitch x:Name="NotificationsToggle" Header="启用边界提醒"
                                              Toggled="NotificationsToggle_Toggled" />
                                <ToggleSwitch x:Name="MuteToggle" Header="暂停提醒（时间进度继续）"
                                              Toggled="MuteToggle_Toggled" />
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,6" />
                                <ToggleSwitch x:Name="FocusToggle" Header="上课 / 下课"
                                              Toggled="CategoryToggle_Toggled" />
                                <ToggleSwitch x:Name="RestToggle" Header="课间 / 长休息"
                                              Toggled="CategoryToggle_Toggled" />
                                <ToggleSwitch x:Name="LunchToggle" Header="午休开始 / 结束"
                                              Toggled="CategoryToggle_Toggled" />
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,6" />
                                <TextBlock x:Name="PermissionText" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="发送测试通知" Click="TestNotification_Click" />
                                    <Button Content="打开系统通知设置" Click="OpenNotificationSettings_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 常规 -->
                <ScrollViewer x:Name="GeneralScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" Spacing="16" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock Text="常规" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="关闭设置窗口不会退出；提醒由后台进程继续判断。"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="12">
                                <ToggleSwitch x:Name="StartupToggle" Header="登录时启动（可选）"
                                              Toggled="StartupToggle_Toggled" />
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,6" />
                                <TextBlock x:Name="VersionText" />
                                <TextBlock x:Name="ConfigPathText" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="打开配置文件夹" Click="OpenConfigFolder_Click" />
                                    <Button Content="退出应用" Click="Exit_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <!-- 时段编辑浮层 -->
        <Grid x:Name="EditorOverlay" Visibility="Collapsed" Background="#66000000">
            <Border Width="560" MaxHeight="720" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="10" Padding="24"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="EditorTitle" Text="编辑时段" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBox x:Name="EditorName" Header="名称" PlaceholderText="例如：第 3 节 / 午休" />
                        <ComboBox x:Name="EditorKind" Header="类型" MinWidth="200">
                            <x:String>上课</x:String>
                            <x:String>课间</x:String>
                            <x:String>长休息</x:String>
                            <x:String>午休</x:String>
                        </ComboBox>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="EditorStart" Header="开始（HH:mm）" PlaceholderText="10:00"
                                     TextChanged="EditorStart_TextChanged" />
                            <TextBox x:Name="EditorEnd" Grid.Column="1" Header="结束（HH:mm）" PlaceholderText="10:45"
                                     TextChanged="EditorEnd_TextChanged" />
                        </Grid>
                        <NumberBox x:Name="EditorMinutes" Header="持续（分钟）" Minimum="1" Maximum="1439"
                                   SpinButtonPlacementMode="Compact" ValueChanged="EditorMinutes_ValueChanged" />
                        <StackPanel Spacing="4">
                            <Slider x:Name="EditorSlider" Minimum="5" Maximum="180" StepFrequency="5"
                                    ValueChanged="EditorSlider_ValueChanged" />
                            <TextBlock x:Name="EditorSliderHint" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="滑块步进 5 分钟；需要精确到 1 分钟时请用数字框。" />
                        </StackPanel>
                        <TextBlock Text="作用范围" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <RadioButtons x:Name="EditorScope" SelectedIndex="0">
                            <x:String>仅今天</x:String>
                            <x:String>永久修改模板</x:String>
                        </RadioButtons>
                        <TextBlock x:Name="EditorScopeHint" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="后续时段" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <RadioButtons x:Name="EditorStrategy" SelectedIndex="0">
                            <x:String>顺延后续时段</x:String>
                            <x:String>后续保持不变</x:String>
                        </RadioButtons>
                        <InfoBar x:Name="EditorError" Severity="Error" IsOpen="False" IsClosable="False" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button x:Name="DeleteButton" Content="删除该时段" Click="DeleteSegment_Click" />
                            <Button Content="取消" Click="EditorCancel_Click" />
                            <Button x:Name="SaveButton" Content="保存调整" Style="{StaticResource AccentButtonStyle}"
                                    Click="EditorSave_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
